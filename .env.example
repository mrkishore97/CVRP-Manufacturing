# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PLANT_TIMEZONE=America/Toronto

# Backend service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000

# Persistence
DATABASE_PATH=data/route_optimizer.db

# Google Maps Platform (backend only; leave blank until you have a restricted key)
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_ROUTES_MATRIX_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
ROUTING_REQUEST_TIMEOUT_SECONDS=15
ROUTING_MAX_ATTEMPTS=3
ROUTING_RETRY_BASE_DELAY_SECONDS=0.25
ROUTES_MAX_ORIGINS=25
ROUTES_MAX_DESTINATIONS=25
ROUTES_MAX_ELEMENTS=625
MATRIX_CACHE_TTL_SECONDS=86400
MATRIX_DEPARTURE_BUCKET_MINUTES=60
# Ask the planner to confirm a travel-time calculation above this many billable elements
MATRIX_CONFIRM_ELEMENTS=400

# Address resolution (Version 1.1)
# Two-letter region bias sent to Google; leave blank for no bias
GEOCODE_REGION_CODE=ca
# How long resolved addresses are cached; Google allows at most 30 days (2592000 s)
GEOCODE_CACHE_TTL_SECONDS=2592000
# A match farther than this straight-line distance from the plant needs review
GEOCODE_MAX_PLANT_DISTANCE_KM=500
# Addresses resolved in parallel per request
GEOCODE_MAX_CONCURRENCY=4

# Solving (Version 1.1)
# Default solver time limit, and the most a planner may choose on the Optimize page
SOLVER_TIME_LIMIT_SECONDS=10
SOLVER_MAX_TIME_LIMIT_SECONDS=120
# Solved plans kept per scenario; older ones are deleted
PLAN_HISTORY_LIMIT=20
# Solve in a separate worker process so the API answers during a solve (recommended)
SOLVER_IN_SUBPROCESS=true
