{
  "fixture_version": "1.0",
  "scenario_id": "H",
  "name": "Timezone and deadline normalization boundaries",
  "category": "datetime_validation",
  "description": "Date-only, naive, aware, invalid-order, and daylight-saving inputs have explicit outcomes.",
  "timezone": "America/Toronto",
  "cases": [
    {
      "case_id": "H-DATE-ONLY",
      "input": {
        "ready_at": "2026-06-22T07:00:00",
        "due_at": "2026-06-22",
        "applicable_shift_end": "2026-06-22T17:00:00-04:00"
      },
      "expected": {
        "accepted": true,
        "normalized_ready_at": "2026-06-22T07:00:00-04:00",
        "normalized_due_at": "2026-06-22T17:00:00-04:00",
        "warning_code": "DATE_ONLY_DEADLINE_NORMALIZED"
      }
    },
    {
      "case_id": "H-AWARE",
      "input": {
        "ready_at": "2026-06-22T09:00:00-04:00",
        "due_at": "2026-06-22T15:00:00-04:00"
      },
      "expected": {
        "accepted": true,
        "ready_at_utc": "2026-06-22T13:00:00+00:00",
        "due_at_utc": "2026-06-22T19:00:00+00:00"
      }
    },
    {
      "case_id": "H-READY-AFTER-DUE",
      "input": {
        "ready_at": "2026-06-22T16:00:00-04:00",
        "due_at": "2026-06-22T15:00:00-04:00"
      },
      "expected": {"accepted": false, "error_code": "READY_AFTER_DUE"}
    },
    {
      "case_id": "H-DST-NONEXISTENT",
      "input": {
        "ready_at": "2026-03-08T02:30:00",
        "due_at": "2026-03-08T05:00:00"
      },
      "expected": {"accepted": false, "error_code": "NONEXISTENT_LOCAL_TIME"}
    },
    {
      "case_id": "H-DST-AMBIGUOUS",
      "input": {
        "ready_at": "2026-11-01T01:30:00",
        "due_at": "2026-11-01T04:00:00"
      },
      "expected": {"accepted": false, "error_code": "AMBIGUOUS_LOCAL_TIME"}
    }
  ]
}
